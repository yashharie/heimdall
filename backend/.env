# ──────────────────────────────────────────────────────────────────────────────
# HEIMDALL backend — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# MySQL connection URL
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://heimdall_user:changeme@127.0.0.1:3306/heimdall

# ── Connection pool tuning ────────────────────────────────────────────────────
# Maximum number of connections in the pool (default: 10)
DATABASE_MAX_CONNECTIONS=10
# Minimum idle connections kept alive (default: 2)
DATABASE_MIN_CONNECTIONS=2
# Seconds to wait for a connection from the pool before timing out (default: 30)
DATABASE_CONNECT_TIMEOUT_SECS=30
# Seconds a connection can stay idle before being closed (default: 600 = 10 min)
DATABASE_IDLE_TIMEOUT_SECS=600
# Seconds a connection can live before being recycled (default: 1800 = 30 min)
DATABASE_MAX_LIFETIME_SECS=1800

# ── Server ────────────────────────────────────────────────────────────────────
# Address and port the HTTP server listens on
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG controls tracing output levels per module.
# Examples: "info", "heimdall_backend=debug,sqlx=warn"
RUST_LOG=info
