  "query": "\n        SELECT\n            id,\n            computer_id,\n            office_id,\n            metric_type,\n            recorded_at,\n            agent_ts,\n            latency_ms,\n            jitter_ms,\n            packet_loss_pct,\n            download_mbps,\n            upload_mbps,\n            outage_duration_ms,\n            link_type,\n            link_speed_mbps,\n            asn,\n            isp_name,\n            quality\n        FROM metrics\n        WHERE computer_id = ?\n          AND metric_type = ?\n          AND quality     = 'ok'\n        ORDER BY recorded_at DESC\n        LIMIT 1\n        ",
